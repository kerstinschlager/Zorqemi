NODE_ENV=production
# Zorqemi own-server configuration
# Copy to .env on the server. NEVER commit the real .env file.
POSTGRES_DB=zorqemi
POSTGRES_USER=zorqemi
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Optional: database connection pool size
DB_POOL_MAX=10

# Stripe production secrets
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Internal maintenance endpoint token
INTERNAL_MAINTENANCE_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
ALLOW_MERCHANT_REGISTRATION=true
ZQ_PLATFORM_ADMIN_EMAILS=admin@example.com

# Public checkout origins (comma-separated)
ZORQEMI_ALLOWED_CHECKOUT_ORIGINS=https://zorqemi.de,https://www.zorqemi.de,https://zorqemishop.de,https://www.zorqemishop.de
